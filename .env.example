# Choose one provider: openai or deepseek
AGENT_PROVIDER=deepseek

# DeepSeek config
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# OpenAI config, used when AGENT_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
# AGENT_MODEL=gpt-4o

# --- Path config (optional, set if your directory layout differs) ---

# Where daily progress notes are written (and read by weekly agent)
# Default: auto-detected from script location, only needed for sharing
DAILY_PROGRESS_DIR=~/your-work-dir/日志/每日进展

# Where weekly reports are written
WEEKLY_REPORT_DIR=~/your-work-dir/日志/周报

# Default scan root for --auto-scan (daily agent only)
SCAN_DIR=~/your-work-dir

# Optional: path to an existing weekly report used as style reference
# REFERENCE_WEEKLY_REPORT=~/your-work-dir/日志/2026-05-15周报.md

# Optional: custom daily progress note template (default: templates/daily_progress_template.md)
# DAILY_TEMPLATE_PATH=~/your-work-dir/日志/每日进展/_模板.md
